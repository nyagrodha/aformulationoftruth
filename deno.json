{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run -A --watch=public/,routes/,islands/ dev.ts",
    "start": "deno run --allow-all main.ts",
    "test": "deno test --allow-net --allow-read --allow-write --allow-env",
    "hooks": "git config core.hooksPath hooks"
  },
  "imports": {
    "$fresh/": "https://deno.land/x/fresh@1.7.3/",
    "preact": "https://esm.sh/preact@10.24.3",
    "preact/": "https://esm.sh/preact@10.24.3/",
    "$std/": "https://deno.land/std@0.216.0/",
    "postgres": "https://deno.land/x/postgres@v0.19.3/mod.ts",
    "zod": "https://deno.land/x/zod@v3.23.8/mod.ts",
    "preact-render-to-string": "https://esm.sh/preact-render-to-string@6.5.11?external=preact"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "exclude": ["**/_fresh/*", "unused-20260612"],
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 120,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": true,
    "proseWrap": "preserve"
  }
}
