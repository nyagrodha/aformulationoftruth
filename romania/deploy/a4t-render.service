[Unit]
Description=a formulation of truth — key box render service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=liar
EnvironmentFile=/home/liar/keybox.env
WorkingDirectory=/home/liar/romania
ExecStart=/home/liar/.deno/bin/deno run --allow-read --allow-write --allow-run --allow-net --allow-env render-service.ts
Restart=on-failure
RestartSec=10s

# The plaintext floor. PrivateTmp gives this unit its own /tmp and /var/tmp,
# both memory-backed and invisible to every other process; RENDER_WORK_ROOT
# defaults to /tmp for that reason. NOT /dev/shm — Deno refuses every operation
# there without --allow-all, which would mean un-sandboxing this service to
# obtain a tmpfs it already has. /dev/shm stays in ReadWritePaths only so an
# operator who overrides RENDER_WORK_ROOT is not silently broken.
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/liar/keybox /dev/shm

[Install]
WantedBy=multi-user.target
